{
  "name": "thermocycler-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de termociclador y sistema de entrenamiento",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @thermocycler/web -- --host 0.0.0.0 --port 3000",
    "build": "npm run build -w @thermocycler/web",
    "build:core": "npm run build -w @thermocycler/core",
    "test:core": "npm run test -w @thermocycler/core",
    "demo:core": "npm run demo -w @thermocycler/core",
    "dev:web": "npm run dev -w @thermocycler/web",
    "build:web": "npm run build -w @thermocycler/web"
  },
  "engines": {
    "node": ">=21"
  }
}
